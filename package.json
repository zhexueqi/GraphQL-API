{
  "name": "backend-coding-test-graphql",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=95",
    "validate:data": "node scripts/validate-data.js",
    "check": "node --check src/config.js && node --check src/data.js && node --check src/schema.js && node --check src/app.js && node --check src/server.js && node --check scripts/validate-data.js && npm run validate:data && npm run test:coverage"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "express": "^5.1.0",
    "graphql": "^16.11.0"
  }
}
